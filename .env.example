# Copy this file to .env and fill in your values
# cp .env.example .env

# RPC endpoint — defaults to local anvil if not set
RPC_URL=http://127.0.0.1:8545

# Deployer private key (no 0x prefix needed for forge)
PRIVATE_KEY=0xPrivateKey

# Optional token overrides (Deploy.s.sol defaults are used if not set)
# TOKEN_NAME=No Null State
# TOKEN_SYMBOL=NNS
# TOKEN_SUPPLY=1000000
# VAULT_NAME=NNS Vault Share
# VAULT_SYMBOL=NSHARE
